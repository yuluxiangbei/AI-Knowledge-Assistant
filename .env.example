# 复制为 .env 并填写真实值。.env 已被 gitignore,不会提交。

# 应用
APP_NAME=AI-Knowledge-Assistant
DEBUG=false

# 安全(生产必须修改!建议 32+ 字节随机串)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库(MySQL 跑在 Docker)
DATABASE_URL=mysql+asyncmy://app:app123456@127.0.0.1:3306/ai_knowledge?charset=utf8mb4

# 上传限制
MAX_UPLOAD_SIZE_MB=10
MAX_DOCS_PER_USER=50

# LLM(DeepSeek,OpenAI 兼容协议)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding(本地 BGE 模型)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# 切片
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG
TOP_K=5

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_knowledge_chunks

# CORS(前端)
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
